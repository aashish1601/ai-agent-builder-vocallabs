# Nhost platform secrets used by nhost/nhost.toml.
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret
NHOST_WEBHOOK_SECRET=nhost-webhook-secret
HASURA_GRAPHQL_JWT_SECRET=replace-with-a-random-32-byte-base64-value
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Functions connect directly to PostgreSQL for atomic transactions.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/local

# Optional. Without it, llm_call uses a disclosed 900 ms deterministic stub.
GROQ_API_KEY=

# Optional notification transport. Without it, notify logs a disclosed demo delivery.
SLACK_WEBHOOK_URL=

# Only used by scripts/seed-demo.ts
DEMO_PASSWORD=AgentForge!2026
